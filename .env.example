# Token de acesso do Meta (System User token de longa duração é o recomendado).
# Permissões necessárias:
#   pages_read_engagement, pages_show_list, read_insights,
#   instagram_basic, instagram_manage_insights, business_management
META_ACCESS_TOKEN=

# Opcional: ID do Business Manager (portfólio). Se preenchido, a descoberta usa
# /{business}/owned_pages + /{business}/client_pages em vez de /me/accounts.
META_BUSINESS_ID=

# Opcional: versão da Graph API (default: v26.0)
META_API_VERSION=v26.0

# Opcional: diretório onde os snapshots históricos locais são gravados
# (default: ~/.meta-business-insights-mcp)
META_DATA_DIR=

# Opcional: restringe o portfólio a estes Page IDs (separados por vírgula)
META_PAGE_IDS=

# ---------------------------------------------------------------------------
# Modo HTTP (npm run start:http) — só para o servidor compartilhado na VPS.
# No uso local via stdio nada abaixo é necessário.
# ---------------------------------------------------------------------------

# Bearers aceitos, no formato nome:token separados por vírgula. Um por pessoa:
# o nome aparece no log e tirar alguém é remover a entrada, sem trocar o
# segredo dos outros. Gere cada token com `openssl rand -hex 32`.
# O servidor se recusa a subir se esta variável estiver vazia.
MCP_HTTP_TOKENS=

# Opcional: porta (default 8787) e interface (default 127.0.0.1).
# Mantenha em 127.0.0.1 — quem expõe para fora, com TLS, é o reverse proxy.
MCP_HTTP_PORT=8787
MCP_HTTP_HOST=127.0.0.1

# Opcional: caminho do endpoint MCP (default /mcp)
MCP_HTTP_PATH=/mcp

# ---------------------------------------------------------------------------
# OAuth (opcional) — necessário para o conector funcionar no app de celular e
# no claude.ai. Sem MCP_OAUTH_ISSUER nada muda: o servidor segue só com bearer
# estático, como a ponte mcp-remote espera.
#
# Não substitui MCP_HTTP_TOKENS. Os bearers pessoais continuam sendo a
# credencial — a pessoa digita o dela uma vez na tela /authorize deste
# servidor, e o Claude guarda a sessão daí em diante.
# ---------------------------------------------------------------------------

# URL pública do servidor, sem barra final. Precisa ser https (o token pessoal
# viaja no POST do /authorize).
MCP_OAUTH_ISSUER=

# Par fixo que cada pessoa cola em "Advanced settings" ao adicionar o conector.
# É o mesmo para a equipe inteira: identifica o Claude, não a pessoa.
#   openssl rand -hex 16   # client id
#   openssl rand -hex 32   # client secret
MCP_OAUTH_CLIENT_ID=
MCP_OAUTH_CLIENT_SECRET=

# Opcional: callbacks extras além dos do Claude (claude.ai e claude.com) e do
# loopback do Desktop. Separados por vírgula. Normalmente fica vazio.
MCP_OAUTH_REDIRECT_URIS=

# ---------------------------------------------------------------------------
# Escrita (responder e ocultar comentários)
# ---------------------------------------------------------------------------

# Desligado por padrão. Ligar registra as tools reply_comment e hide_comment.
# No modo HTTP isto é só a primeira tranca: o bearer da pessoa ainda precisa do
# sufixo :write em MCP_HTTP_TOKENS (ex.: ana:3f9c…:write).
META_ALLOW_WRITES=false
