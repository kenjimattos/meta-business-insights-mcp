# Token de acesso do Meta (System User token de longa duração é o recomendado).
# Permissões necessárias:
#   pages_read_engagement, pages_show_list, read_insights,
#   instagram_basic, instagram_manage_insights, business_management
META_ACCESS_TOKEN=

# Opcional: ID do Business Manager (portfólio). Se preenchido, a descoberta usa
# /{business}/owned_pages + /{business}/client_pages em vez de /me/accounts.
META_BUSINESS_ID=

# Opcional: versão da Graph API (default: v26.0)
META_API_VERSION=v26.0

# Opcional: diretório onde os snapshots históricos locais são gravados
# (default: ~/.meta-business-insights-mcp)
META_DATA_DIR=

# Opcional: restringe o portfólio a estes Page IDs (separados por vírgula)
META_PAGE_IDS=
