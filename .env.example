# Token de acesso do Meta (System User token de longa duração é o recomendado).
# Permissões necessárias:
#   pages_read_engagement, pages_show_list, read_insights,
#   instagram_basic, instagram_manage_insights, business_management
META_ACCESS_TOKEN=

# Opcional: ID do Business Manager (portfólio). Se preenchido, a descoberta usa
# /{business}/owned_pages + /{business}/client_pages em vez de /me/accounts.
META_BUSINESS_ID=

# Opcional: versão da Graph API (default: v26.0)
META_API_VERSION=v26.0

# Opcional: diretório onde os snapshots históricos locais são gravados
# (default: ~/.meta-business-insights-mcp)
META_DATA_DIR=

# Opcional: restringe o portfólio a estes Page IDs (separados por vírgula)
META_PAGE_IDS=

# ---------------------------------------------------------------------------
# Modo HTTP (npm run start:http) — só para o servidor compartilhado na VPS.
# No uso local via stdio nada abaixo é necessário.
# ---------------------------------------------------------------------------

# Quem pode entrar pelo login Google, no formato e-mail[:write] separado por
# vírgula. É a lista principal: nada de segredo para gerar ou distribuir, e
# tirar alguém é remover a entrada.
# Estar no domínio do Workspace (GOOGLE_HD) não basta — esta lista diz quem do
# time olha o portfólio.
MCP_ALLOWED_EMAILS=

# Saída de emergência: bearers estáticos no formato nome:token[:write],
# separados por vírgula. Serve para o curl de diagnóstico e para a ponte local
# stdio→HTTP. Opcional quando o login Google está configurado; gere com
# `openssl rand -hex 32`.
# O servidor se recusa a subir se as duas listas estiverem vazias.
MCP_HTTP_TOKENS=

# Opcional: porta (default 8787) e interface (default 127.0.0.1).
# Mantenha em 127.0.0.1 — quem expõe para fora, com TLS, é o reverse proxy.
MCP_HTTP_PORT=8787
MCP_HTTP_HOST=127.0.0.1

# Opcional: caminho do endpoint MCP (default /mcp)
MCP_HTTP_PATH=/mcp

# ---------------------------------------------------------------------------
# Login Google (opcional) — é o que faz o conector funcionar no app de celular
# e no claude.ai, e o que dispensa instalar Node na máquina de cada pessoa.
# Sem MCP_OAUTH_ISSUER nada disso sobe e o servidor segue só com bearer
# estático, como a ponte mcp-remote espera.
#
# O Google entra só no momento do login, para provar quem é a pessoa. Não
# guardamos token dele nem chamamos API deles depois: o acesso ao Meta continua
# sendo o META_ACCESS_TOKEN único desta VPS.
# ---------------------------------------------------------------------------

# URL pública do servidor, sem barra final. Precisa ser https — o Google recusa
# redirect_uri sem TLS.
MCP_OAUTH_ISSUER=

# Credenciais do OAuth client criado no Google Cloud Console (tipo Web
# application). O redirect URI autorizado lá deve ser exatamente:
#   {MCP_OAUTH_ISSUER}/oauth/google/callback
# Com Workspace, deixe a tela de consentimento como Internal: não há processo
# de verificação.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Domínio do Workspace exigido na claim `hd` do id_token. Vazio aceita qualquer
# conta Google que esteja em MCP_ALLOWED_EMAILS.
GOOGLE_HD=

# ---------------------------------------------------------------------------
# Escrita (responder e ocultar comentários)
# ---------------------------------------------------------------------------

# Desligado por padrão. Ligar registra as tools reply_comment e hide_comment.
# No modo HTTP isto é só a primeira tranca: o bearer da pessoa ainda precisa do
# sufixo :write em MCP_HTTP_TOKENS (ex.: ana:3f9c…:write).
META_ALLOW_WRITES=false
