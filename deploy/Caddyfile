# /etc/caddy/Caddyfile
#
# O Caddy resolve o certificado sozinho via Let's Encrypt, desde que o
# subdomínio já aponte para o IP da VPS e as portas 80 e 443 estejam abertas.
# TLS não é opcional aqui: o bearer viaja no header a cada request.

mcp.exemplo.com {
	encode zstd gzip

	reverse_proxy 127.0.0.1:8787 {
		# Desliga o buffering da resposta. Sem isso o Caddy segura os eventos
		# SSE até o fim do stream e as consultas longas (o Meta é lento)
		# parecem travadas para o Claude.
		flush_interval -1
	}

	log {
		output file /var/log/caddy/mcp.log
		# Remove o header Authorization do log. Precisa ser o encoder
		# `filter` envolvendo o `json` — passar os campos direto para o
		# `json` não é sintaxe válida e o Caddy recusa a configuração.
		format filter {
			wrap json
			fields {
				request>headers>Authorization delete
			}
		}
	}
}
